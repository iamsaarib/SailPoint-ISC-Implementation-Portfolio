    "type": "lookup",
    "attributes": {
        "input": {
            "type": "lower",
            "attributes": {
                "input": {
                    "type": "trim",
                    "attributes": {
                        "input": {
                            "type": "identityAttribute",
                            "attributes": {
                                "name": "employmentType"
                            }
                        }
                    }
                }
            }
        },
        "table": {
            "employee": "OU=Employee,OU=People,DC=example,DC=com",
            "contractor": "OU=Contractor,OU=People,DC=example,DC=com"
        }
    },
    "internal": false
}
